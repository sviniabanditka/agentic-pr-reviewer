# Copy to .deploy.env (git-ignored) and fill in. Read by scripts/deploy.sh and scripts/set-secret.sh.
DEPLOY_SSH=root@your-k3s-host           # ssh target with kubectl on it
DEPLOY_SSH_KEY=~/.ssh/id_ed25519        # key for that host
KUBECONFIG_REMOTE=/etc/rancher/k3s/k3s.yaml
NAMESPACE=pr-reviewer
REGISTRY=registry.example.com           # docker must be logged in to it
IMAGE_NAME=agentic-pr-reviewer
PUBLIC_HOST=review.example.com          # ingress host; needs a DNS record
