{
  "name": "agentic-pr-reviewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test tests",
    "check": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "deploy": "./scripts/deploy.sh",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "apr": "bun src/cli/apr.ts",
    "build:cli": "bun build --compile src/cli/apr.ts --outfile dist/apr"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.2",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "typebox": "^1.3.19"
  }
}
